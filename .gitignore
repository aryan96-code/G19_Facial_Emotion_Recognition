# ============================================================
# G19 Facial Emotion Recognition — Git Ignore Rules
# ============================================================

# --- Dataset (too large for Git; download separately) ---
dataset/
!dataset/.gitkeep

# --- Trained model weights (use Git LFS or share via Drive) ---
models/*.h5
models/*.keras
models/*.pb
!models/.gitkeep

# --- Results (generated during experiments) ---
results/
!results/.gitkeep

# --- Python virtual environment ---
venv/
env/
.venv/

# --- Python cache files ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# --- Jupyter Notebook checkpoints ---
.ipynb_checkpoints/

# --- macOS system files ---
.DS_Store
.AppleDouble
.LSOverride

# --- IDE / Editor settings ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Environment variables / secrets ---
.env
*.env

# --- Logs ---
*.log
logs/

# --- Temporary files ---
*.tmp
*.bak
*.swp
*~
